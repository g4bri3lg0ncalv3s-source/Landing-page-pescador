# Copie este arquivo para .env e preencha com suas credenciais reais.
# Token gerado pelo @BotFather no Telegram:
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# IDs numéricos dos administradores autorizados a operar comandos em DM privada
# (separados por vírgula; se vazio, todos os comandos ficam bloqueados - fail-closed):
TELEGRAM_ADMIN_IDS=

# ID do canal ou grupo onde o bot poderá publicar ofertas automaticamente (ex.: -100... ou @canal):
TELEGRAM_CHANNEL_ID=-1001234567890

# Intervalo em segundos entre cada postagem automática no canal (padrão: 600s = 10 min):
PUBLISH_INTERVAL_SECONDS=600

# Habilita publicações automáticas no canal ao iniciar (padrão seguro: false):
AUTO_PUBLISH_ENABLED=false

# Caminho do arquivo de banco de dados SQLite (relativo à pasta raiz do projeto):
DATABASE_PATH=data/ofertas.db

# --- Regras de Qualidade, Desconto e Republicação (Opcional) ---
# Comprimento máximo da legenda da foto (máximo do Telegram: 1024):
COPY_MAX_CAPTION_LENGTH=1024
# Percentual mínimo real de desconto (%) exigido em todas as fontes:
COPY_MIN_DISCOUNT_PERCENT=5.0
# Dias de espera antes de permitir republicar o mesmo produto no canal:
REPUBLISH_COOLDOWN_DAYS=15
# Queda extra mínima (%) sobre o último preço publicado para antecipar republicação:
REPUBLISH_MIN_PRICE_DROP_PERCENT=10.0

# --- Fontes Oficiais de Ofertas (Opcional até aprovação comercial) ---
# Shopee Affiliate Open API (https://affiliate.shopee.com.br -> Open API):
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# Mercado Livre Developers API (https://developers.mercadolivre.com.br):
MERCADOLIVRE_APP_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_ACCESS_TOKEN=
MERCADOLIVRE_REFRESH_TOKEN=

# Identificadores de comissão do Programa de Afiliados do Mercado Livre:
MERCADOLIVRE_AFFILIATE_WORD=
MERCADOLIVRE_AFFILIATE_TOOL=
