# Copie este arquivo para .env e preencha com suas credenciais reais.
# Token gerado pelo @BotFather no Telegram:
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ID do canal ou grupo onde o bot poderá publicar ofertas automaticamente:
TELEGRAM_CHANNEL_ID=123456789

# Intervalo em segundos entre cada postagem automática no canal (padrão: 180s = 3 min):
PUBLISH_INTERVAL_SECONDS=180

# Habilita publicações automáticas no canal ao iniciar (mantenha false até aprovar/validar):
AUTO_PUBLISH_ENABLED=false

# Caminho do arquivo de banco de dados SQLite (relativo à pasta raiz do projeto):
DATABASE_PATH=data/ofertas.db

# --- Personalização de Copywriting e Mensagens (Opcional) ---
# Quantidade máxima de emojis por publicação:
COPY_MAX_EMOJIS=12
# Tom da comunicação (comercial, direto ou neutro):
COPY_TONE=comercial
# Comprimento máximo da legenda da foto (máximo do Telegram: 1024):
COPY_MAX_CAPTION_LENGTH=1024
# Percentual mínimo de desconto para exibir chamada promocional de destaque:
COPY_MIN_DISCOUNT_PERCENT=5.0

# --- Fontes Oficiais de Ofertas (Opcional até aprovação comercial) ---
# Shopee Affiliate Open API (https://affiliate.shopee.com.br -> Open API):
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# Mercado Livre Developers API (https://developers.mercadolivre.com.br):
MERCADOLIVRE_APP_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_ACCESS_TOKEN=
MERCADOLIVRE_REFRESH_TOKEN=

# Identificadores de comissão do Programa de Afiliados do Mercado Livre:
MERCADOLIVRE_AFFILIATE_WORD=
MERCADOLIVRE_AFFILIATE_TOOL=
